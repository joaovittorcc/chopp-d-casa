{
  "name": "chopp-d-casa",
  "version": "1.0.0",
  "description": "Vitrine digital / cardápio demonstrativo - Chopp D'Casa",
  "main": "index.html",
  "scripts": {
    "dev": "concurrently \"npm run watch:css\" \"npm run serve\"",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "build": "npm run build:css",
    "serve": "live-server --port=4231 --no-browser --ignore=node_modules,src,stitch-export"
  },
  "keywords": ["cardapio", "vitrine-digital", "choperia", "bar"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "tailwindcss": "^3.4.1"
  }
}
